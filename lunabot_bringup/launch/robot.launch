<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- ============================== -->
    <!-- ========= ARGUMENTS ========== -->
    <!-- ============================== -->

    <!-- Type of Robot Args -->
    <arg name="robot_num" default="0"/>
    <let name="ns" if="$(eval '$(var robot_num) == 1')" value="mini"/>
    <let name="ns" if="$(eval '$(var robot_num) == 0')" value=""/>
    <arg name="sim" default="false"/>
    <let name="real" value="$(eval '\'$(var sim)\' == \'false\'')"/>

    <push_ros_namespace if="$(eval 'len(\'$(var ns)\') > 0')" namespace="$(var ns)"/>

    <!-- Add a slash before the ns if it is not empty -->
    <let name="/ns" if="$(eval 'len(\'$(var ns)\') > 0')" value="/$(var ns)"/>
    <let name="/ns" unless="$(eval 'len(\'$(var ns)\') > 0')" value=""/>

    <!-- Add an underscore after the ns if it is not empty -->
    <let name="ns_" if="$(eval 'len(\'$(var ns)\') > 0')" value="$(var ns)_"/>
    <let name="ns_" unless="$(eval 'len(\'$(var ns)\') > 0')" value=""/>

    <let name="starting_x" if="$(eval '$(var robot_num) == 1')" value="1.5"/>
    <let name="starting_x" if="$(eval '$(var robot_num) == 0')" value="2.5"/>


    <!-- What to Launch Args -->
    <arg name="autonomy" default="true" />
    <arg name="record" default="$(var real)" />
    <arg name="slam" default="true" />
    <arg name="teensy" default="$(var real)" />
    <arg name="loginternet" default="false" />
    
    <!-- Robot Description Args -->

    <!-- Camera Args -->
    <arg name="cameras" default="true" />

    <let name="cam_1_name"              value="d455_front"/>
    <let name="cam_2_name"              value="d455_back"/>
    <let name="cam_3_name"              value="d455_front"/>
    <let name="cam_4_name"              value="d455_back"/>
    <!-- Main -->
    <arg name="cams"                    default="'12'"      if="$(eval '$(var robot_num) == 0')"/> <!-- Camera numbers -->
    <arg name="odom_cam_name"           default="$(var cam_2_name)"  if="$(eval '$(var robot_num) == 0')"/>

    <!-- Mini -->
    <arg name="cams"                    default="'34'"      if="$(eval '$(var robot_num) == 1')"/> <!-- Camera numbers -->
    <arg name="odom_cam_name"           default="$(var cam_3_name)"  if="$(eval '$(var robot_num) == 1')"/>

    <let name="cam_1_topic"             value="$(var /ns)/$(var cam_1_name)/color/image_raw $(var /ns)/$(var cam_1_name)/depth/image_raw "
        if="$(eval '\'1\' in $(var cams)')"/>
    <let name="cam_1_topic"             value="" 
        unless="$(eval '\'1\' in $(var cams)')"/>
    <let name="cam_2_topic"             value="$(var /ns)/$(var cam_2_name)/color/image_raw $(var /ns)/$(var cam_2_name)/depth/image_raw "
        if="$(eval '\'2\' in $(var cams)')"/>
    <let name="cam_2_topic"             value="" 
        unless="$(eval '\'2\' in $(var cams)')"/>
    <let name="cam_3_topic"             value="$(var /ns)/$(var cam_3_name)/color/image_raw $(var /ns)/$(var cam_3_name)/depth/image_raw "
        if="$(eval '\'3\' in $(var cams)')"/>
    <let name="cam_3_topic"             value="" 
        unless="$(eval '\'3\' in $(var cams)')"/>
    <let name="cam_4_topic"             value="$(var /ns)/$(var cam_4_name)/color/image_raw $(var /ns)/$(var cam_4_name)/depth/image_raw "
        if="$(eval '\'4\' in $(var cams)')"/>
    <let name="cam_4_topic"             value="" 
        unless="$(eval '\'4\' in $(var cams)')"/>

    <arg name="pointcloud"                      default="$(eval 'len($(var cams)) > 1')" />

    <!-- Differential Drive Args -->
    <arg name="diff_drive_hz"           default="20.0"/>
    <!-- Main -->
    <arg name="width"                   default="0.5588"    if="$(eval '$(var robot_num) == 0')"/>
    <arg name="max_speed_percentage"    default="0.8"       if="$(eval '$(var robot_num) == 0')"/>
    <arg name="max_speed"               default="1000"      if="$(eval '$(var robot_num) == 0')"/>
    <arg name="wheel_diameter"          default="0.3429"    if="$(eval '$(var robot_num) == 0')"/>
    <arg name="gearbox_ratio"           default="50.0"/>
    <!-- Mini -->
    <arg name="width"                   default="0.5588"    if="$(eval '$(var robot_num) == 1')"/>
    <arg name="max_speed_percentage"    default="0.8"       if="$(eval '$(var robot_num) == 1')"/>
    <arg name="max_speed"               default="1000"      if="$(eval '$(var robot_num) == 1')"/>
    <arg name="wheel_diameter"          default="0.3429"    if="$(eval '$(var robot_num) == 1')"/>
    <arg name="gearbox_ratio"           default="50.0"        if="$(eval '$(var robot_num) == 1')"/>

    <!-- Record Args -->
    <arg name="exp_name" default="exp" />

    <!-- ============================== -->
    <!-- ======= LAUNCH NODES ========= -->
    <!-- ============================== -->

    <!-- Launch Teensy Driver -->
    <node if="$(var teensy)" name="teensy_driver" pkg="lunabot_embedded" exec="teensy_driver_node" 
            output="screen">        
        <!-- Input -->
        <remap from="effort" to="effort"/>
        <remap from="led_color" to="led_color"/>

        <!-- Output -->
        <remap from="sensors" to="sensors"/>
    </node>

    <!-- Launch Robot State, Joint State Publishers (TFs) -->
    <include file="$(find-pkg-share lunabot_description)/launch/robot_description.launch.py">
        <arg name="entity_name" value="$(var entity_name)"/>
        <arg name="ns" value="$(var ns)"/>
        <arg name="sim" value="$(var sim)"/>
    </include>

    <!-- Launch Cameras -->
    <include if="$(var cameras)" file="$(find-pkg-share lunabot_perception)/launch/cameras.launch">
        <arg name="robot_num" value="$(var robot_num)"/>
        <arg name="ns" value="$(var ns)"/>
        <arg name="sim" value="$(var sim)"/>
    </include>
        

    <include if="$(var record)" file="$(find-pkg-share lunabot_bringup)/launch/record.launch">
        <arg name="exp_name" value="$(var exp_name)" />
    </include>

    <node if="$(var sim)" name="manual_controller_node" pkg="lunabot_control" exec="manual_controller_node" output="screen" respawn="true">
    </node>

    <node if="$(var sim)" name="drivetrain_controller_node" pkg="lunabot_control" exec="drivetrain_controller_node" output="screen" respawn="true" />
    <node if="$(var sim)" pkg="controller_manager" exec="spawner" args="-p $(find-pkg-share lunabot_config)/config/controller.yaml velocity_controller"/>
    <node pkg="lunabot_slam" exec="map_base_node.py">
        <remap from="odom" to="$(var /ns)/rtabmap/odom"/>
        <remap from="position" to="$(var /ns)/position"/>
    </node>

    <group if="$(var autonomy)">
        <!-- Launch diff drive controller -->
        <node name="differential_drive_controller_node" pkg="lunabot_control" 
                exec="differential_drive_controller_node" output="screen" respawn="true" >
            <param name="use_sim_time" value="$(var sim)"/>

            <param name="width" value="$(var width)"/>
            <param name="max_speed_percentage" value="$(var max_speed_percentage)"/>
            <param name="hz" value="$(var diff_drive_hz)"/>
            <param name="max_speed" value="$(var max_speed)"/>
            <param name="wheel_diameter" value="$(var wheel_diameter)"/>
            <param name="gearbox_ratio" value="$(var gearbox_ratio)"/>
            
            <!-- Input -->
            <remap from="cmd_vel" to="cmd_vel"/>
            <remap from="sensors" to="sensors"/>
            <remap from="autonomy" to="autonomy"/>

            <!-- Output -->
            <remap from="right_drive" to="right_drive"/>
            <remap from="left_drive" to="left_drive"/>
        </node>
        


        <!-- Launch effort factory -->
        <node name="effort_factory_node" pkg="lunabot_control" exec="effort_factory_node" 
                output="screen" respawn="true" >
            <param name="use_sim_time" value="$(var sim)"/>
            
            <!-- Input -->
            <remap from="effort" to="effort"/>

            <!-- Output -->
            <remap from="autonomy" to="autonomy"/>

        </node>

        <push_ros_namespace namespace="rtabmap"/>

        <!-- Odometry -->
        <node pkg="rtabmap_odom" exec="rgbd_odometry" output="screen" name="rgbd_odometry" ros_args="--log-level WARN">
            <param name="use_sim_time" value="$(var sim)"/>
            
            <param name="subscribe_depth"     value="true"/>
            <param name="frame_id"            value="$(var ns)base_link"/>
            <param name="odom_frame_id"            value="$(var ns)odom"/>
            <param name="Odom/ResetCountdown" value="'1'"/>


            <remap from="depth/image"         to="$(var /ns)/$(var odom_cam_name)/aligned_depth_to_color/image_raw"/>
            <remap from="rgb/image"           to="$(var /ns)/$(var odom_cam_name)/color/image_raw"/>
            <remap from="rgb/camera_info"     to="$(var /ns)/$(var odom_cam_name)/color/camera_info"/>
        </node>

        <let if="$(var pointcloud)" name="scan_cloud" value="$(var /ns)/pointcloud/depth_combined_cloud"/>
        <let unless="$(var pointcloud)" name="scan_cloud" value="$(var /ns)/$(var odom_cam_name)/points"/>
        <node if="$(var slam)" name="rtabmap" pkg="rtabmap_slam" exec="rtabmap" output="screen" args="--delete_db_on_start" ros_args="--log-level WARN">
            <param name="use_sim_time" value="$(var sim)"/>

            <param name="frame_id"                value="$(var ns)base_link"/>
            <param name="map_frame_id"            value="$(var ns)map"/>

            <param name="subscribe_rgb"           value="true"/>
            <param name="subscribe_depth"         value="true"/>
            <param name="subscribe_rgbd"          value="false"/>
            <param name="subscribe_scan_cloud"    value="true"/>

            <remap from="odom"                    to="odom"/>
            <remap from="scan_cloud"              to="$(var scan_cloud)"/>


            <remap from="depth/image"             to="$(var /ns)/$(var odom_cam_name)/aligned_depth_to_color/image_raw"/>
            <remap from="rgb/image"               to="$(var /ns)/$(var odom_cam_name)/color/image_raw"/>
            <remap from="rgb/camera_info"         to="$(var /ns)/$(var odom_cam_name)/color/camera_info"/>

            <param name="sync_queue_size"         value="10"/>
            <param name="approx_sync"             value="true"/>
            <param name="map_always_update"       value="true"/>

            <!-- RTAB-Map's parameters -->
            <param name="Grid/Sensor"             value="'0'"/> <!-- Only use point clouds-->
            <param name="Grid/FootprintLength"    value="'1.0'"/>
            <param name="Grid/FootprintWidth"     value="'0.75'"/> 
            <param name="Grid/MaxGroundAngle"     value="'30'"/> <!-- 30 degree normal before marked as obstacle -->
            <param name="Grid/3D"                 value="'true'"/> <!-- 3D occupancy grid -->
            <param name="Grid/FromDepth"          value="'false'"/> <!-- occupancy grid from lidar -->

        </node>
    </group>


    <group>
        <node name="planner_server" pkg="nav2_planner" exec="planner_server" output="screen" respawn="true">
          <param from="$(find-pkg-share lunabot_config)/config/planner.yml"/>
          <param name="use_sim_time" value="$(var sim)"/>
        </node>

        <node name="lifecycle" pkg="nav2_lifecycle_manager" exec="lifecycle_manager" output="screen">
          <param name="autostart" value="true"/>
          <param name="node_names" value="planner_server" value-sep=";"/>
          <param name="use_sim_time" value="$(var sim)"/>
        </node>

        <node name="nav2_bridge" pkg="lunabot_nav" exec="nav2_bridge_node" output="screen" respawn="true">
          <remap from="nav_path" to="nav_path"/>
          <param name="use_sim_time" value="$(var sim)"/>
        </node>

        <node name="point_to_point_node" pkg="lunabot_control" exec="point_to_point_node" output="screen" respawn="false" >
            <param name="use_sim_time" value="$(var sim)"/>

            <remap from="odom" to="position"/>
            <remap from="global_path" to="nav_path"/>
            <remap from="backwards" to="traversal/backwards"/>
            <remap from="traversal_enabled" to="behavior/traversal_enabled"/>

            <remap from="cmd_vel" to="cmd_vel"/>
        </node>
    </group>

    <group if="$(var sim)">
        <node exec="create" pkg="ros_gz_sim" args="--topic $(var entity_name)/robot_description --name $(var entity_name) -x $(var starting_x) -y 1.75
            -z 0.0 -Y -1.570796327"/>

        <node name="image_bridge_cam_1_color" pkg="ros_gz_image" exec="image_bridge" args="$(var /ns)/$(var cam_1_name)/color/image_raw" if="$(eval '\'1\' in $(var cams)')"/>
        <node name="image_bridge_cam_1_depth" pkg="ros_gz_image" exec="image_bridge" args="$(var /ns)/$(var cam_1_name)/aligned_depth_to_color/image_raw" if="$(eval '\'1\' in $(var cams)')"/>
        <node name="image_bridge_cam_2_color" pkg="ros_gz_image" exec="image_bridge" args="$(var /ns)/$(var cam_2_name)/color/image_raw" if="$(eval '\'2\' in $(var cams)')"/>
        <node name="image_bridge_cam_2_depth" pkg="ros_gz_image" exec="image_bridge" args="$(var /ns)/$(var cam_2_name)/aligned_depth_to_color/image_raw" if="$(eval '\'2\' in $(var cams)')"/>
        <node name="image_bridge_cam_3_color" pkg="ros_gz_image" exec="image_bridge" args="$(var /ns)/$(var cam_3_name)/color/image_raw" if="$(eval '\'3\' in $(var cams)')"/>
        <node name="image_bridge_cam_3_depth" pkg="ros_gz_image" exec="image_bridge" args="$(var /ns)/$(var cam_3_name)/aligned_depth_to_color/image_raw" if="$(eval '\'3\' in $(var cams)')"/>
        <node name="image_bridge_cam_4_color" pkg="ros_gz_image" exec="image_bridge" args="$(var /ns)/$(var cam_4_name)/color/image_raw" if="$(eval '\'4\' in $(var cams)')"/>
        <node name="image_bridge_cam_4_depth" pkg="ros_gz_image" exec="image_bridge" args="$(var /ns)/$(var cam_4_name)/aligned_depth_to_color/image_raw" if="$(eval '\'4\' in $(var cams)')"/>
    </group>
</launch>
