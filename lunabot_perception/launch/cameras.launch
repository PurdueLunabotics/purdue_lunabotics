<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- ============================== -->
  <!-- ========= ARGUMENTS ========== -->
  <!-- ============================== -->

  <!-- Type of Camera Args -->
  <arg name="sim"                           default="false"/>
  <arg name="lidar"                         default="false"/>

  <arg name="robot_num"                     default="0" />

  <arg name="ns" if="$(eval '$(var robot_num) == 1')" default="mini"/>
  <arg name="ns" if="$(eval '$(var robot_num) == 0')" default=""/>
  <push_ros_namespace namespace="$(var ns)"/>

  <let name="serial_no_cam_1"               value="'141222070808'"/>
  <arg name="cam_1_name"                    default="d455_front"/>
  <let name="serial_no_cam_2"               value="'349622073231'"/>
  <arg name="cam_2_name"                    default="d455_back"/>

  <let name="serial_no_cam_3"               value="'339222072367'"/>
  <arg name="cam_3_name"                    default="d455_front"/>
  <let name="serial_no_cam_4"               value="'939622074382'"/>
  <arg name="cam_4_name"                    default="d455_back"/>

  <arg name="cams"                    default="'12'"      if="$(eval '$(var robot_num) == 0')"/> <!-- Camera numbers -->
  <arg name="cams"                    default="'34'"      if="$(eval '$(var robot_num) == 1')"/> <!-- Camera numbers -->


  <arg name="pointcloud"                      default="true" />

  <arg name="profile"                         default="424x240x15" if="$(eval '$(var robot_num) == 0')"/>
  <arg name="profile"                         default="848x480x30" if="$(eval '$(var robot_num) == 1')"/>

  <let name="initial_reset"                   value="true"/>
  <let name="decimation"                      value="4"/> 
  <let name="voxel_size"                      value="0.01"/> <!--meters-->
  <let name="noise_filter_radius"             value="0.1"/> <!--meters radius-->
  <let name="max_depth"                       value="2.0"/> <!--meters-->


  <let name="/ns" if="$(eval 'len(\'$(var ns)\') > 0')" value="/$(var ns)"/>
  <let name="/ns" unless="$(eval 'len(\'$(var ns)\') > 0')" value=""/>
  <let name="ns/" if="$(eval 'len(\'$(var ns)\') > 0')" value="$(var ns)/"/>
  <let name="ns/" unless="$(eval 'len(\'$(var ns)\') > 0')" value=""/>

  <group if="$(eval '\'1\' in $(var cams)')">
    <include file="$(find-pkg-share lunabot_perception)/launch/cameras_single.launch">
      <arg name="camera_name"                   value="$(var cam_1_name)"/>
      <arg name="serial_no"                     value="$(var serial_no_cam_1)"/>
      <arg name="tf_prefix"                     value="$(var ns/)"/>
    </include>
  </group>

  <group if="$(eval '\'2\' in $(var cams)')">
    <include file="$(find-pkg-share lunabot_perception)/launch/cameras_single.launch">
      <arg name="camera_name"                 value="$(var cam_2_name)"/>
      <arg name="serial_no"                   value="$(var serial_no_cam_2)"/>
      <arg name="tf_prefix"                   value="$(var ns/)"/>
    </include>
  </group>

  <group if="$(eval '\'3\' in $(var cams)')">
    <include file="$(find-pkg-share lunabot_perception)/launch/cameras_single.launch">
      <arg name="camera_name"                 value="$(var cam_3_name)"/>
      <arg name="serial_no"                   value="$(var serial_no_cam_3)"/>
      <arg name="tf_prefix"                   value="$(var ns/)"/>
    </include>
  </group>

  <group if="$(eval '\'4\' in $(var cams)')">
    <include file="$(find-pkg-share lunabot_perception)/launch/cameras_single.launch">
      <arg name="camera_name"                 value="$(var cam_4_name)"/>
      <arg name="serial_no"                   value="$(var serial_no_cam_4)"/>
      <arg name="tf_prefix"                   value="$(var ns/)"/>
    </include>
  </group>

  <group if="$(var pointcloud)">
    <push_ros_namespace namespace="pointcloud"/>
    
    <!-- Aggregate pointclouds from each camera (if using multiple cameras)-->
    <!-- <node pkg="rtabmap_util" exec='point_cloud_aggregator' name="point_cloud_aggregator" respawn="true">
      <remap from="cloud$(eval '$(var cams).find(\'1\')+1')" to="$(var /ns)/$(var cam_1_name)/points" />
      <remap from="cloud$(eval '$(var cams).find(\'2\')+1')" to="$(var /ns)/$(var cam_2_name)/points" />
      <remap from="cloud$(eval '$(var cams).find(\'3\')+1')" to="$(var /ns)/$(var cam_3_name)/points" />
      <remap from="cloud$(eval '$(var cams).find(\'4\')+1')" to="$(var /ns)/$(var cam_4_name)/points" />
      <remap from="combined_cloud" to="depth_combined_cloud"/>       
      <param name="count" value="$(eval 'len($(var cams))')"/>
      <param name="xyz_output" value="true"/>
      <param name="fixed_frame_id" value="$(var ns/)base_link" />
      <param name="approx_sync" value="true"/>
    </node> -->

    <node pkg="rtabmap_util" exec='point_cloud_aggregator' name="point_cloud_aggregator" respawn="true">
      <remap from="cloud1" to="$(var /ns)/$(var cam_1_name)/points" />
      <remap from="cloud2" to="$(var /ns)/$(var cam_2_name)/points" />
      <remap from="cloud3" to="$(var /ns)/$(var cam_3_name)/points" />
      <remap from="cloud4" to="$(var /ns)/$(var cam_4_name)/points" />
      <remap from="combined_cloud" to="depth_combined_cloud"/>       
      <param name="count" value="2"/> 
      <param name="xyz_output" value="true"/>
      <param name="fixed_frame_id" value="$(var ns)base_link" />
      <param name="approx_sync" value="true"/>
    </node>
  </group>
</launch>
