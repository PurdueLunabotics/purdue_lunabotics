<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="serial_no_d435_right"           default="'053122251286'"/>  <arg name="serial_no_d455_front"            default="'141222070808'"/>
  <arg name="serial_no_d435_left"           default="'053122251335'"/>
  <arg name="serial_no_d455_back"            default="'939622074382'"/>
  <arg name="profile"                           default="640x480x30"/>

  <arg name="output_width"                      default="640"/>
  <arg name="output_height"                     default="480"/>

  <arg name="initial_reset"                   default="true"/>

  <arg name="front"                           default="true"/>
  <arg name="back"                           default="false"/>
  <arg name="pointcloud" default="false" />

  <arg name="decimation" default="4"/>
  <arg name="voxel_size" default="0.01"/> <arg name="noise_filter_radius" default="0.1"/> <arg name="max_depth" default="3.0"/> <group if="$(var front)">
    <push_ros_namespace namespace="d455_front"/>

      <node pkg="realsense2_camera" exec="realsense2_camera_node" name="d455_front">
        <param name="serial_no" value="$(var serial_no_d455_front)"/>
        <param name="initial_reset" value="false"/>
        <param name="pointcloud.enable" value="false"/>
        <param name="enable_sync" value="true"/>
        <param name="align_depth.enable" value="true"/>
        <param name="enable_depth" value="true"/>
        <param name="depth_module.profile" value="$(var profile)" /> 
        <param name="enable_color" value="true"/>
        <param name="rgb_camera.profile" value="$(var profile)" /> 
        <param name="decimation_filter.enable" value="true"/>
        <param name="publish_tf" value="true"/>
        <param name="tf_publish_rate" value="0.0"/> 
    </node>

    <node_container pkg="rclcpp_components" exec="component_container_mt" name="front_camera_container" namespace="">
      
      <composable_node pkg="isaac_ros_image_proc" plugin="nvidia::isaac_ros::image_proc::RectifyNode" name="color_rectify_color">
        <param name="output_width" value="$(var output_width)" />
        <param name="output_height" value="$(var output_height)" />
        <remap from="image_raw" to="/d455_front/d455_front/color/image_raw" />
        <remap from="camera_info" to="/d455_front/d455_front/color/camera_info" />
        <remap from="image_rect" to="/d455_front/d455_front/color/image_rect_color" />
      </composable_node>

      <composable_node pkg="isaac_ros_depth_image_proc" plugin="nvidia::isaac_ros::depth_image_proc::PointCloudXyzNode" name="point_cloud_isaac">
        <remap from="depth/camera_info" to="/d455_front/d455_front/aligned_depth_to_color/camera_info" />
        <remap from="depth/image_rect" to="/d455_front/d455_front/aligned_depth_to_color/image_raw" />
        <remap from="points" to="/d455_front/points" />
      </composable_node>

      <composable_node pkg="isaac_ros_apriltag" plugin="nvidia::isaac_ros::apriltag::AprilTagNode" name="apriltag_node">
        <param name="size" value="0.162"/> 
        <param name="max_tags" value="64"/>
        <remap from="image" to="/d455_front/d455_front/color/image_rect_color" />
        <remap from="camera_info" to="/d455_front/d455_front/color/camera_info" />
        <remap from="tag_detections" to="/d455_front/tag_detections" />
      </composable_node>

    </node_container>
  </group>

  <group if="$(var back)">

    <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
      <arg name="serial_no"                value="$(var serial_no_d455_back)"/>
      <arg name="camera_name" value ="d455_back" />
      <arg name="camera_namespace" value ="" />
      <arg name="base_frame_id" value ="link" />


      <arg name="initial_reset"            value="$(var initial_reset)"/>

      <arg name="pointcloud.enable"        value="false"/>
      <arg name="enable_sync"              value="true"/>
      <arg name="align_depth.enable"              value="true"/>

      <arg name="enable_depth"             value="true"/>
      <arg name="depth_module.depth_profile" value="$(var profile)" />

      <arg name="enable_color"             value="true"/>
      <arg name="rgb_camera.color_profile" value="$(var profile)" />

      <arg name="decimation_filter.enable" value="true"/>

      <arg name="publish_tf"               value="true"/>
      <arg name="tf_publish_rate"          value="0"/>

      <arg name="clip_distance"            value="-1"/>


  <arg name="width"                    value="424"/>
      <arg name="height"                   value="240"/>
      <arg name="output_width"             value="424"/>
      <arg name="output_height"            value="240"/>
      <arg name="crop_mode"                value="CENTER"/>
    </include>
    <push_ros_namespace namespace="d455_back"/>

    <include file="$(find-pkg-share lunabot_perception)/launch/apriltag.launch">
      <arg name="camera_frame" value="d455_back_link" />
      <arg name="camera_topic" value="color/image_raw"/>

      <arg name="use_sim_time" value="false"/>
    </include>


    <node pkg="isaac_ros_image_proc" exec="rectify_node" name="color_rectify_color">
    <param name="output_width" value="$(var output_width)" />
    <param name="output_height" value="$(var output_height)" />
       <remap from="image_raw" to="color/image_raw" />
       <remap from="camera_info" to="color/camera_info" />
       <remap from="image_rect" to="color/image_rect_color" />
    </node>

   <node pkg="isaac_ros_depth_image_proc" exec="point_cloud_xyz_node" name="point_cloud_isaac" respawn="true">
      <remap from="depth/camera_info" to="aligned_depth_to_color/camera_info" />
      <remap from="depth/image_rect" to="aligned_depth_to_color/image_raw" />
      <remap from="points" to="points" /> </node>
  </group>

  <group if="$(var pointcloud)">
    <push_ros_namespace namespace="pointcloud"/>
    
    <node pkg="rtabmap_util" exec='point_cloud_aggregator' name="point_cloud_aggregator" respawn="true">
      <remap from="cloud1" to="/d455_back/points" />
      <remap from="cloud2" to="/d455_front/points" />
      <remap from="combined_cloud" to="depth_combined_cloud"/>       
      <param name="count" value="2"/>
      <param name="xyz_output" value="true"/>
      <param name="fixed_frame_id" value="base_link" />
      <param name="approx_sync" value="true"/>
    </node>
  </group>

</launch>
