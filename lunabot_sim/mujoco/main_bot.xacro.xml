<?xml version="1.0"?>
<mujoco model="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find lunabot_description)/urdf/main_bot_constants.xacro.xml" />

  <asset>
    <texture type="2d" file="./tag36_11_00126.png" />
    <material name="tag126" texture="tag36_11_00126" />
    <texture type="2d" file="./tag36_11_00173.png" />
    <material name="tag173" texture="tag36_11_00173" />
  </asset>

  <default>
    <default class="wheel">
        <geom type="cylinder" size="${wheel_radius} ${wheel_width/2}" friction="1 0.005 0.0001" />
    </default>
  </default>

  <worldbody>
    <body pos="3.1 1.285 0.0" name="robot">
      <freejoint />
      <geom type="box" size="${body_dim_x/2} ${body_dim_y/2} ${body_dim_z/2}" pos="0 0 ${body_pos_z}"/>

      <site type="box" size="${dep_apriltag_small_size/2} ${dep_apriltag_small_size/2} 0.001" pos="${dep_apriltag_pos_x} ${dep_apriltag_small_pos_y} ${dep_apriltag_pos_z}" euler="0 -${90 + dep_apriltag_pitch * 180 / pi} -90" material="tag173"/>
      <site type="box" size="${dep_apriltag_size/2} ${dep_apriltag_size/2} 0.001" pos="${dep_apriltag_pos_x} ${dep_apriltag_pos_y} ${dep_apriltag_pos_z}" euler="0 -${90 + dep_apriltag_pitch * 180 / pi} -90" material="tag126"/>

      <camera name="back" fovy="58" resolution="424 240" pos="${cam_back_x} ${cam_back_y} ${cam_back_z}" euler="0 ${90 - cam_back_pitch * 180 / pi} 90" />

      <body pos="${wheel_pos_x} ${wheel_pos_y} ${wheel_pos_z}" euler="-90 0 0">
        <geom class="wheel" />
        <joint name="left front" type="hinge" />
      </body>
      <body pos="-${back_wheel_pos_x} ${wheel_pos_y} ${wheel_pos_z}" euler="-90 0 0">
        <geom class="wheel" />
        <joint name="left back" type="hinge" />
      </body>
      <body pos="${wheel_pos_x} -${wheel_pos_y} ${wheel_pos_z}" euler="-90 0 0">
        <geom class="wheel" />
        <joint name="right front" type="hinge" />
      </body>
      <body pos="-${back_wheel_pos_x} -${wheel_pos_y} ${wheel_pos_z}" euler="-90 0 0">
        <geom class="wheel" />
        <joint name="right back" type="hinge" />
      </body>

      <body pos="${exc_pos_x} 0 ${exc_pos_z}" euler="0 ${exc_pitch * 180 / pi} 0">
        <geom type="box" size="${exc_dim_x/2} ${exc_dim_y/2} ${exc_dim_z/2}" />
        <joint name="excavation" type="slide" axis="1 0 0" range="-0.2 0" damping="100" />

        <camera name="front" fovy="58" resolution="424 240" pos="${cam_front_x} ${cam_front_y} ${cam_front_z}" euler="0 ${90 + cam_front_pitch * 180 / pi} 90" />
      </body>
    </body>
  </worldbody>

  <tendon>
    <fixed name="left">
      <joint joint="left front" coef="1"/>
      <joint joint="left back" coef="1"/>
    </fixed>
    <fixed name="right">
      <joint joint="right front" coef="1"/>
      <joint joint="right back" coef="1"/>
    </fixed>
  </tendon>

  <actuator>
    <intvelocity name="excavation" joint="excavation" kp="10000" kv="100" ctrlrange="-5 5" actrange="-0.16 0" />
    <velocity name="left" tendon="left" kv="100" ctrlrange="-5 5" />
    <velocity name="right" tendon="right" kv="100" ctrlrange="-5 5" />
  </actuator>

  <sensor>
    <jointpos name="exc_pos" joint="excavation" />
    <jointactuatorfrc name="exc_effort" joint="excavation" />
    <framepos name="odom_pos" objtype="xbody" objname="robot" reftype="geom" refname="ground" />
    <framequat name="odom_rot" objtype="xbody" objname="robot" reftype="geom" refname="ground" />
  </sensor>
</mujoco>
