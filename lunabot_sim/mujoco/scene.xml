<mujoco model="scene">
  <option integrator="implicit" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072" />

    <texture type="2d" name="lunar_surface" file="./lunar_texture.png" />
    <material name="lunar_surface" texture="lunar_surface" texuniform="true" texrepeat="0.25 0.25"/>
    <hfield name="surface" size="4.05 2.285 0.3 0.1" file="height.png"/>

    <mesh file="./rock_round.stl" />
    <mesh file="./rock_rough.stl" />

    <mesh name="rock1" file="./67016-2_SFM_Web-Resolution-Model_Coordinate-Registered/67016-2_SFM_Web-Resolution-Model_Coordinate-Registered.obj" scale="15 15 15" />
    <texture type="2d" name="rock1" file="./67016-2_SFM_Web-Resolution-Model_Coordinate-Registered/67016-2_SFM_Web-Resolution-Model_Coordinate-Registered.png" />
    <material name="rock1" texture="rock1" />

    <texture type="2d" file="./tag36_11_00126.png" />
    <material name="tag126" texture="tag36_11_00126" />
    <texture type="2d" file="./tag36_11_00173.png" />
    <material name="tag173" texture="tag36_11_00173" />
    <texture type="2d" file="./tag36_11_00301.png" />
    <material name="tag301" texture="tag36_11_00301" />
    <texture type="2d" file="./tag36_11_00421.png" />
    <material name="tag421" texture="tag36_11_00421" />
    <texture type="2d" file="./tag36_11_00476.png" />
    <material name="tag476" texture="tag36_11_00476" />
    <texture type="2d" file="./tag36_11_00482.png" />
    <material name="tag482" texture="tag36_11_00482" />
  </asset>

  <default>
    <default class="wheel">
        <geom type="cylinder" size="0.2 0.0625" friction="1 0.005 0.0001" />
    </default>
    <default class="mini wheel">
        <geom type="cylinder" size="0.03 0.045" friction="1 0.005 0.0001" />
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <!-- <geom type="hfield" hfield="surface" material="lunar_surface" pos="0 0 -0.3" /> -->
    <geom type="plane" size="4.05 2.285 0.1" material="lunar_surface" name="ground" />
    <!-- <site type="box" size="1.3 1 .01" pos="-2.75 -1.285 0" /> -->
    <!-- <site type="box" size="1 1 .01" pos="3.05 1.285 0" /> -->
    <!-- <site type="box" size="2 2.285 .01" pos="2.05 0 0" /> -->
    <body pos="0 0 0.1" euler="90 0 -45">
      <geom type="mesh" mesh="rock1" material="rock1"/>
    </body>

    <site type="box" size="0.0805555 0.0805555 .001" pos="3.05 2.285 0.25" material="tag301" euler="90 0 0"/>
    <site type="box" size="0.0805555 0.0805555 .001" pos="4.05 1.285 0.25" material="tag482" euler="90 -90 0"/>

    <body pos="3.1 1.285 0.3" name="robot">
      <freejoint />
      <geom type="box" size="0.425 0.25 0.05" pos="-0.05 0 0"/>

      <site type="box" size="0.0111 0.0111 0.001" pos="-0.42 0.09 0.21" euler="0 -70 -90" material="tag173"/>
      <site type="box" size="0.05335 0.05335 0.001" pos="-0.42 -0.02 0.21" euler="0 -70 -90" material="tag126"/>

      <camera name="back" fovy="58" resolution="424 240" pos="-0.44 0.02 0.33" euler="0 50 90" />

      <body pos="0.3 0.32 -0.1" euler="-90 0 0">
        <geom class="wheel" />
        <joint name="left front" type="hinge" />
      </body>
      <body pos="-0.3 0.32 -0.1" euler="-90 0 0">
        <geom class="wheel" />
        <joint name="left back" type="hinge" />
      </body>
      <body pos="0.3 -0.32 -0.1" euler="-90 0 0">
        <geom class="wheel" />
        <joint name="right front" type="hinge" />
      </body>
      <body pos="-0.3 -0.32 -0.1" euler="-90 0 0">
        <geom class="wheel" />
        <joint name="right back" type="hinge" />
      </body>

      <body pos="0.4 0 0.2" euler="0 -120 0">
        <geom type="box" size="0.375 0.065 0.05" />
        <joint name="excavation" type="slide" axis="1 0 0" range="-0.2 0" damping="100" />

        <camera name="front" fovy="58" resolution="424 240" pos="0.3 0 -0.15" euler="0 52 90" />
      </body>
    </body>

    <body pos="2.4 1.385 0.15" euler="0 0 180" name="mini robot">
      <freejoint />
      <geom type="box" size="0.1775 0.214 0.05" pos="-0.05 0 0"/>

      <camera name="mini back" fovy="58" resolution="424 240" pos="-0.155 0 0.36" euler="180 90 90" />
      <camera name="mini front" fovy="58" resolution="424 240" pos="0.189 0.162 0.37" euler="0 -60 90" />

      <body pos="0.05 0.305 -0.12" euler="-90 0 0">
        <geom class="mini wheel" />
        <joint name="mini left front" type="hinge" />
      </body>
      <body pos="-0.2 0.305 -0.12" euler="-90 0 0">
        <geom class="mini wheel" />
        <joint name="mini left back" type="hinge" />
      </body>
      <body pos="0.05 -0.305 -0.12" euler="-90 0 0">
        <geom class="mini wheel" />
        <joint name="mini right front" type="hinge" />
      </body>
      <body pos="-0.2 -0.305 -0.12" euler="-90 0 0">
        <geom class="mini wheel" />
        <joint name="mini right back" type="hinge" />
      </body>
    </body>
  </worldbody>

  <tendon>
    <fixed name="left">
      <joint joint="left front" coef="1"/>
      <joint joint="left back" coef="1"/>
    </fixed>
    <fixed name="right">
      <joint joint="right front" coef="1"/>
      <joint joint="right back" coef="1"/>
    </fixed>

    <fixed name="mini left">
      <joint joint="mini left front" coef="1"/>
      <joint joint="mini left back" coef="1"/>
    </fixed>
    <fixed name="mini right">
      <joint joint="mini right front" coef="1"/>
      <joint joint="mini right back" coef="1"/>
    </fixed>
  </tendon>

  <actuator>
    <intvelocity name="excavation" joint="excavation" kp="10000" kv="100" ctrlrange="-5 5" actrange="-0.16 0" />
    <velocity name="left" tendon="left" kv="100" ctrlrange="-5 5" />
    <velocity name="right" tendon="right" kv="100" ctrlrange="-5 5" />
    <velocity name="mini left" tendon="mini left" kv="2" gear=".2" ctrlrange="-5 5" />
    <velocity name="mini right" tendon="mini right" kv="2" gear=".2" ctrlrange="-5 5" />
  </actuator>

  <sensor>
    <jointpos name="exc_pos" joint="excavation" />
    <jointactuatorfrc name="exc_effort" joint="excavation" />
    <framepos name="odom_pos" objtype="xbody" objname="robot" reftype="geom" refname="ground" />
    <framequat name="odom_rot" objtype="xbody" objname="robot" reftype="geom" refname="ground" />
    <framepos name="mini_odom_pos" objtype="xbody" objname="mini robot" reftype="geom" refname="ground" />
    <framequat name="mini_odom_rot" objtype="xbody" objname="mini robot" reftype="geom" refname="ground" />
  </sensor>
</mujoco>
