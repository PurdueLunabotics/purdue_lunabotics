<?xml version="1.0"?>
<mujoco model="mini robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find lunabot_description)/urdf/mini_bot_constants.xacro.xml" />

  <default>
    <default class="mini wheel">
      <geom type="cylinder" size="${wheel_radius} ${wheel_width/2}" friction="1 0.005 0.0001" />
    </default>
  </default>

  <worldbody>
    <body pos="2.4 1.385 0.0" euler="0 0 180" name="mini robot">
      <freejoint />
      <geom type="box" size="${body_dim_x/2} ${body_dim_y/2} ${body_dim_z/2}" pos="0 0 ${body_pos_z}"/>

      <camera name="mini back" fovy="58" resolution="424 240" pos="${cam_back_x} ${cam_back_y} ${cam_back_z}" euler="180 90 90" />
      <camera name="mini front" fovy="58" resolution="424 240" pos="${cam_front_x} ${cam_front_y} ${cam_front_z}" euler="0 -${90 - cam_front_pitch * 180 / pi} 90" />

      <body pos="${wheel_pos_x} ${wheel_pos_y} ${wheel_pos_z}" euler="-90 0 0">
        <geom class="mini wheel" />
        <joint name="mini left front" type="hinge" />
      </body>
      <body pos="-${back_wheel_pos_x} ${wheel_pos_y} ${wheel_pos_z}" euler="-90 0 0">
        <geom class="mini wheel" />
        <joint name="mini left back" type="hinge" />
      </body>
      <body pos="${wheel_pos_x} -${wheel_pos_y} ${wheel_pos_z}" euler="-90 0 0">
        <geom class="mini wheel" />
        <joint name="mini right front" type="hinge" />
      </body>
      <body pos="-${back_wheel_pos_x} -${wheel_pos_y} ${wheel_pos_z}" euler="-90 0 0">
        <geom class="mini wheel" />
        <joint name="mini right back" type="hinge" />
      </body>
    </body>
  </worldbody>

  <tendon>
    <fixed name="mini left">
      <joint joint="mini left front" coef="1"/>
      <joint joint="mini left back" coef="1"/>
    </fixed>
    <fixed name="mini right">
      <joint joint="mini right front" coef="1"/>
      <joint joint="mini right back" coef="1"/>
    </fixed>
  </tendon>

  <actuator>
    <velocity name="mini left" tendon="mini left" kv="2" gear=".2" ctrlrange="-5 5" />
    <velocity name="mini right" tendon="mini right" kv="2" gear=".2" ctrlrange="-5 5" />
  </actuator>

  <sensor>
    <framepos name="mini_odom_pos" objtype="xbody" objname="mini robot" reftype="geom" refname="ground" />
    <framequat name="mini_odom_rot" objtype="xbody" objname="mini robot" reftype="geom" refname="ground" />
  </sensor>
</mujoco>
