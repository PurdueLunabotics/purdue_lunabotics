<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="robot_num" default="0" />

  <group if="$(eval '($(var robot_num) == 1)')">
    <push_ros_namespace namespace="mini" if="$(eval '($(var robot_num) == 1)')"/>
    <node pkg="lunabot_behavior" exec="traversal_mini"/>
  </group>

  <group if="$(eval '($(var robot_num) == 0)')">
    <node pkg="lunabot_behavior" exec="traversal_main"/>
  </group>
</launch>
